DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Database — self-hosted Postgres (the `db` service in docker-compose.yml).
# Compose overrides DATABASE_URL for the web/celery containers, building it from
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB. To change the credentials, set
# those three in a `.env` file at the repo root (next to docker-compose.yml).
# The value below is only used when running manage.py directly on the host.
DATABASE_URL=postgresql://bouncetrap:bouncetrap@localhost:5432/bouncetrap

# Redis (must match docker-compose service name)
REDIS_URL=redis://redis:6379/0

# CORS / Frontend — set to your production domain.
FRONTEND_URL=https://bouncetrap.net
ALLOWED_HOSTS=bouncetrap.net,www.bouncetrap.net

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Deep verification (internal)
DEEP_VERIFY_API_KEY=
DEEP_VERIFY_API_URL=https://apps.emaillistverify.com/api/verifyEmail

# Kickbox (free plan users)
KICKBOX_API_KEY=

# Email — Resend (resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Stripe
STRIPE_LIVE_MODE=True
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# USDT receiving wallets (manual crypto deposits)
USDT_WALLET_ERC20=
USDT_WALLET_BEP20=
USDT_WALLET_TRC20=

# AWS S3 (set USE_S3=True to enable)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Inbox Placement seed accounts (optional)
SEED_GMAIL_EMAIL=
SEED_GMAIL_PASSWORD=
SEED_OUTLOOK_EMAIL=
SEED_OUTLOOK_PASSWORD=
SEED_YAHOO_EMAIL=
SEED_YAHOO_PASSWORD=
