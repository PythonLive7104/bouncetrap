DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Database (Supabase or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (must match docker-compose service name)
REDIS_URL=redis://redis:6379/0

# CORS / Frontend — set to your production domain
FRONTEND_URL=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Deep verification (internal)
DEEP_VERIFY_API_KEY=
DEEP_VERIFY_API_URL=https://apps.emaillistverify.com/api/verifyEmail

# Kickbox (free plan users)
KICKBOX_API_KEY=

# Email — Resend (resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Stripe
STRIPE_LIVE_MODE=True
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dodo Payments (card / fiat checkout)
DODO_MODE=live
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=

# AWS S3 (set USE_S3=True to enable)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Inbox Placement seed accounts (optional)
SEED_GMAIL_EMAIL=
SEED_GMAIL_PASSWORD=
SEED_OUTLOOK_EMAIL=
SEED_OUTLOOK_PASSWORD=
SEED_YAHOO_EMAIL=
SEED_YAHOO_PASSWORD=
