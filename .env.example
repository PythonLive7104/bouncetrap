# Compose-level settings, read by docker-compose.yml only.
# Copy to `.env` (repo root, next to docker-compose.yml) to override the defaults.
# Application settings live in backend/.env, not here.

# Postgres credentials for the `db` service. Compose builds the containers'
# DATABASE_URL from these three values.
POSTGRES_DB=bouncetrap
POSTGRES_USER=bouncetrap
POSTGRES_PASSWORD=bouncetrap

# Host port the database is published on (loopback only). Change this if another
# Postgres already listens on 5432 locally.
POSTGRES_PORT=5432
